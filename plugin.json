{
  "id": "spotify-soloist",
  "name": "Spotify Soloist",
  "version": "0.1.0",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "remote",
  "permissions": {
    "network": [
      "api.spotify.com",
      "accounts.spotify.com",
      "lrclib.net",
      "music.163.com",
      "c.y.qq.com",
      "u.y.qq.com"
    ],
    "process": [
      "bin/soloist.exe",
      "powershell.exe"
    ]
  },
  "settings": [
    {
      "key": "clientId",
      "label": "Client ID",
      "help": "Your Spotify Web API app Client ID. Add http://127.0.0.1:43110/callback as its redirect URI.",
      "link": "https://developer.spotify.com/dashboard"
    },
    {
      "key": "soloistApiKey",
      "label": "Soloist API Key",
      "type": "password",
      "help": "Your personal Soloist API key (separate from Client ID). Optional if already saved via scripts/soloist-host.ps1.",
      "link": "https://developer.spotify.com/dashboard/soloist"
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "builtin": "liked"
    },
    {
      "builtin": "savedAlbums"
    },
    {
      "title": "Playback Status",
      "page": "soloist",
      "icon": "note"
    }
  ]
}
